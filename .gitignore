# Nothing stateful belongs in this repo — state lives in $LACUNA_DATA.
# These entries exist because it is easy to run the tools from inside a checkout.
__pycache__/
*.py[cod]
.venv/
venv/
venv-docling/
venv-marker/
cost-ledger.jsonl
cache/
books/
# Output directories a user creates when running the pipeline — but NOT the shipped example notes,
# which the README's first run depends on. Without the negation they are silently never committed.
notes/
!examples/notes/
!examples/notes/**
*.unverified.md
*.filelist.txt
.DS_Store
.idea/
.vscode/
.pytest_cache/
