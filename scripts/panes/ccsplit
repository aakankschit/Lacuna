#!/usr/bin/env bash
# Claude Code on the left, its results document on the right (tmux).
# Inside tmux it splits the current window; otherwise it starts a new tmux session.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
PY="${LACUNA_SYSTEM_PYTHON:-python3}"

command -v tmux >/dev/null || { echo "ccsplit needs tmux. Without it, split your terminal by hand and run: $ROOT/bin/lacuna pane <file>" >&2; exit 2; }

# $ROOT as argv, not interpolated into the code: a quote in the plugin path was a SyntaxError
results_dir=$("$PY" -c "import sys; sys.path.insert(0, sys.argv[1] + '/scripts'); import lacuna_config; print(lacuna_config.path('results'))" "$ROOT")
mkdir -p "$results_dir"
proj=$(basename "$PWD")
export CLAUDE_RESULTS_FILE="$results_dir/${proj}-$(date +%Y%m%d-%H%M%S).md"

# tmux runs this string through a shell, so every word is quoted: a space in the plugin path made
# the pane die after `lacuna split` had already exited 0
viewer="$(printf '%q ' "$PY" "$HERE/results_pane.py" "$CLAUDE_RESULTS_FILE")"
if [ -n "${TMUX:-}" ]; then
  tmux split-window -h -l 45% -c "$PWD" "$viewer"
  tmux select-pane -L
  if [ "$#" -eq 0 ]; then exec claude; else exec claude "$@"; fi
fi
sess="cc-${proj//[^A-Za-z0-9]/-}-$(date +%H%M%S)"
claude_cmd="claude"
[ "$#" -gt 0 ] && claude_cmd="claude $(printf '%q ' "$@")"
tmux new-session -d -s "$sess" -c "$PWD" -e "CLAUDE_RESULTS_FILE=$CLAUDE_RESULTS_FILE" "$claude_cmd"
tmux set-option -t "$sess" mouse on >/dev/null
tmux split-window -h -l 45% -t "$sess" -c "$PWD" "$viewer"
tmux select-pane -t "$sess" -L
exec tmux attach -t "$sess"
